# The game's streamed assets on port 8080 (evergrove-asset-server.py), for /etc/systemd/system/.
# Read-only access to /srv/assets and nothing else; after the copy changes, `systemctl reload` rereads its file list.
[Unit]
Description=Evergrove asset server (the game's streamed assets)
After=network-online.target
Wants=network-online.target

[Service]
User=evg-assets
Group=evg-assets
ExecStart=/usr/bin/python3 -I /usr/local/sbin/evergrove-asset-server /srv/assets --port 8080
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/srv/assets
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# AF_UNIX: asyncio's own wake-up socket pair.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=4096
MemoryMax=512M

[Install]
WantedBy=multi-user.target
