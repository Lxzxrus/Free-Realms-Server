<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
	  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- File names say which server wrote them: in Docker every server's process is "dotnet", and all three share
       one Logs folder, so ${processname} gave them all the same files. -->
  <!-- The Info and Error files take at most 200 lines a minute each (under 100 MB a day): Docker's cap
	     covers only the console. Chat and Audit are not limited, so a flood can't push evidence out. -->
	<targets>
    <target name="colouredConsole" xsi:type="ColoredConsole" />
    <target name="infoFile" xsi:type="LimitingWrapper" messageLimit="200" interval="00:01:00">
    	<target name="infoFileWriter" xsi:type="File" fileName="${basedir}/Logs/WebAPI-Info-${shortdate}.log" />
    </target>
    <target name="errorFile" xsi:type="LimitingWrapper" messageLimit="200" interval="00:01:00">
    	<target name="errorFileWriter" xsi:type="File" fileName="${basedir}/Logs/WebAPI-Error-${shortdate}.log" />
    </target>
  </targets>
  <rules>
    <logger name="Microsoft.EntityFrameworkCore.*" maxLevel="Warn" final="true" />

    <!-- ASP.NET Core writes Information lines for every request, before any rate limit, carrying the request's
         path, query and Content-Type, all the sender's to choose (up to 8 KB of path alone). Anyone could fill the
         disk with requests for pages that don't exist. Its warnings and errors still get through. (appsettings.json's
         "Microsoft.AspNetCore": "Warning" doesn't apply: NLog's provider replaces those filters with these rules.) -->
    <logger name="Microsoft.AspNetCore.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Info" writeTo="colouredConsole" />
    <logger name="*" minlevel="Info" maxlevel="Info" writeTo="infoFile" />
    <logger name="*" minlevel="Warn" maxlevel="Fatal" writeTo="errorFile" />
  </rules>
</nlog>
