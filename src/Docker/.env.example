# Settings for docker-compose.yml. Copy this file to .env in this folder (it is git-ignored) and fill in every
# value; Compose refuses to start while one is missing.

# Shared secret between the Login server and the Gateway. Make one with: openssl rand -base64 32
LOGIN_GATEWAY_CHALLENGE=

# Database. Compose creates the database and user on first start. Use long random passwords, for example:
# openssl rand -base64 24 (avoid ; in MYSQL_PASSWORD, because it goes into a connection string).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sanctuary
MYSQL_USER=sanctuary
MYSQL_PASSWORD=
