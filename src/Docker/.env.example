# Settings for docker-compose.yml. Copy this file to .env in this folder (it is git-ignored) and fill in every
# value except the optional ones; Compose refuses to start while a required one is missing.

# Shared secret between the Login server and the Gateway. Make one with: openssl rand -base64 32
LOGIN_GATEWAY_CHALLENGE=

# Database. Compose creates the database and user on first start. Use long random passwords, for example:
# openssl rand -base64 24 (avoid ; in MYSQL_PASSWORD, because it goes into a connection string).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sanctuary
MYSQL_USER=sanctuary
MYSQL_PASSWORD=

# Optional. A Discord webhook address (Channel settings > Integrations > Webhooks) to post new in-game reports to. It is
# a secret: keep it only here (anyone with it can post to that channel; if it leaks, delete the webhook in Discord and
# make a new one). Use a private staff-only channel: Channel settings > Integrations > Webhooks > New Webhook > Copy
# Webhook URL. It must be https://discord.com/api/webhooks/... Leave it empty to post nowhere. Restart the Gateway
# after changing it.
REPORTS_DISCORD_WEBHOOK_URL=
