<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="DotRecast.Core" Version="2026.3.1" />
    <PackageVersion Include="DotRecast.Detour" Version="2026.3.1" />
    <PackageVersion Include="Collections.Pooled" Version="2.0.0-preview.27" />
    <PackageVersion Include="LuaCSharp" Version="0.5.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.20" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.20" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="MiniValidation" Version="0.10.0" />
    <PackageVersion Include="MSTest" Version="4.2.3" />
    <PackageVersion Include="NLog" Version="6.1.4" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="6.1.4" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageVersion Include="Refit" Version="13.1.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="13.1.0" />
    <PackageVersion Include="Sep" Version="0.15.0" />
    <!-- Stay on 3.1.12: ImageSharp 3.2.0 and 4.x refuse to build in Release without a Six Labors license key (a paid
         one, or a free Community key by application). Their build targets only warn in Debug, so tests pass while the
         Release build (CI and Docker) fails. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="ZLibDotNet" Version="0.1.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- ImageSharp 3.1.12 advisories, reviewed 2026-10-11 and 2026-10-29: none is reachable from a portrait upload, the
         only place ImageSharp runs. Uploads are identified and decoded with the PNG codec alone and SkipMetadata (see
         PortraitEndpoints.PngOnly), then saved as PNG. The fixes ship in 3.2.0 and 4.1.2, which both need a license key
         (above). Listed one by one, so a new advisory still shows up in the build. -->
    <!-- TIFF CCITT T6 encoder overflow: we only ever encode PNG. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <!-- TIFF CCITT T4 encoder overflow: we only ever encode PNG. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <!-- HistogramEqualization index: never called; nothing here processes images. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <!-- BigTIFF IFD loop: uploads have no TIFF decoder, and EXIF is skipped. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <!-- ICC CLUT allocation: 3.x parses a profile's tags only when they are read, and nothing reads them. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <!-- Tiled fax TIFF heap overflow, in the TIFF decoder: uploads have no TIFF decoder, and any non-PNG is refused
         before its pixels are decoded. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
  </ItemGroup>
</Project>