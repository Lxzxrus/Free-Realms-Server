<?xml version="1.0" encoding="UTF-8" ?>
<UserControl x:Class="Launcher.Views.Login"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:Launcher.Views"
             xmlns:vm="using:Launcher.ViewModels"
             d:DesignHeight="350"
             d:DesignWidth="500"
             x:DataType="vm:Login"
             mc:Ignorable="d">

  <StackPanel>

    <!-- Warning -->
    <TextBlock HorizontalAlignment="Center"
               Foreground="{StaticResource Color.Warning}"
               IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               MaxWidth="440"
               Text="{Binding Warning, Mode=OneWay}"
               TextAlignment="Center"
               TextWrapping="Wrap" />

    <!-- Username -->
    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">

      <TextBlock HorizontalAlignment="Center"
                 FontFamily="{StaticResource FontDefault}"
                 FontSize="14"
                 Foreground="{StaticResource Color.Muted}"
                 Text="{StaticResource Text.Login.Username}" />

      <TextBox Margin="0,4,0,0"
               Classes="field"
               v:AutoFocusBehaviour.IsEnabled="{Binding AutoFocusUsername}"
               Text="{Binding Username, Mode=TwoWay}" />
    </StackPanel>

    <!-- Remember Username -->
    <CheckBox HorizontalAlignment="Center"
              Content="{StaticResource Text.Login.RememberUsername}"
              FontFamily="{StaticResource FontDefault}"
              FontSize="14"
              IsChecked="{Binding RememberUsername}" />

    <!-- Password -->
    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">

      <TextBlock HorizontalAlignment="Center"
                 FontFamily="{StaticResource FontDefault}"
                 FontSize="14"
                 Foreground="{StaticResource Color.Muted}"
                 Text="{StaticResource Text.Login.Password}" />

      <TextBox Margin="0,4,0,0"
               Classes="field"
               v:AutoFocusBehaviour.IsEnabled="{Binding AutoFocusPassword}"
               PasswordChar="•"
               Text="{Binding Password, Mode=TwoWay}" />
    </StackPanel>

    <!-- Buttons -->
    <StackPanel HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">

      <Button Classes="flat primary"
              Command="{Binding ConfirmCommand}"
              Content="{StaticResource Text.Login}"
              FontFamily="{StaticResource FontDefault}"
              HotKey="Enter">
      </Button>

      <Button Classes="flat primary"
              Command="{Binding CancelCommand}"
              Content="{StaticResource Text.Cancel}"
              FontFamily="{StaticResource FontDefault}">
      </Button>
    </StackPanel>

    <StackPanel Margin="10"
                Orientation="Vertical"
                Spacing="10">

      <!-- Divider -->
      <Rectangle Width="300"
                 Height="1"
                 Fill="{StaticResource Color.FG2}" />

      <Button HorizontalAlignment="Center"
              Classes="flat primary"
              Command="{Binding RegisterCommand}"
              Content="{StaticResource Text.Register}"
              FontFamily="{StaticResource FontDefault}">
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>