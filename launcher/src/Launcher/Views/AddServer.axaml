<?xml version="1.0" encoding="UTF-8" ?>
<UserControl x:Class="Launcher.Views.AddServer"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:Launcher.Views"
             xmlns:vm="using:Launcher.ViewModels"
             d:DesignHeight="100"
             d:DesignWidth="500"
             x:DataType="vm:AddServer"
             mc:Ignorable="d">

  <Grid RowDefinitions="Auto,Auto,Auto">

    <!-- Header -->
    <Grid Grid.Row="0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <TextBlock FontFamily="{StaticResource FontDisplay}"
                 FontSize="24"
                 FontWeight="Bold"
                 Text="{StaticResource Text.Add_Server.ServerUrl}" />
    </Grid>

    <!-- Input -->
    <Grid Grid.Row="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">

      <TextBox Margin="0,4,0,0"
               Classes="field"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               v:AutoFocusBehaviour.IsEnabled="True"
               Text="{Binding ServerUrl, Mode=TwoWay}" />
    </Grid>

    <!-- Buttons -->
    <Grid Grid.Row="2"
          Margin="0,10,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          ColumnDefinitions="Auto,Auto">

      <Button Grid.Column="0"
              Margin="5,0"
              Classes="flat primary"
              Command="{Binding ConfirmCommand}"
              Content="{StaticResource Text.Add}"
              FontFamily="{StaticResource FontDefault}"
              HotKey="Enter">
      </Button>

      <Button Grid.Column="1"
              Margin="5,0"
              Classes="flat primary"
              Command="{Binding CancelCommand}"
              Content="{StaticResource Text.Cancel}"
              FontFamily="{StaticResource FontDefault}">
      </Button>
    </Grid>
  </Grid>
</UserControl>