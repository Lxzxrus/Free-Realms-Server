<?xml version="1.0" encoding="UTF-8" ?>
<UserControl x:Class="Launcher.Views.Register"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:Launcher.Views"
             xmlns:vm="using:Launcher.ViewModels"
             d:DesignHeight="350"
             d:DesignWidth="500"
             x:DataType="vm:Register"
             mc:Ignorable="d">

  <StackPanel>

    <!-- Warning -->
    <TextBlock HorizontalAlignment="Center"
               Foreground="{StaticResource Color.Warning}"
               IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               MaxWidth="440"
               Text="{Binding Warning, Mode=OneWay}"
               TextAlignment="Center"
               TextWrapping="Wrap" />

    <!-- Username -->
    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">

      <TextBlock HorizontalAlignment="Center"
                 FontFamily="{StaticResource FontDefault}"
                 FontSize="14"
                 Foreground="{StaticResource Color.Muted}"
                 Text="{StaticResource Text.Register.Username}" />

      <TextBox Margin="0,4,0,0"
               Classes="field"
               Text="{Binding Username, Mode=TwoWay}" />
    </StackPanel>

    <!-- Password -->
    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">

      <TextBlock HorizontalAlignment="Center"
                 FontFamily="{StaticResource FontDefault}"
                 FontSize="14"
                 Foreground="{StaticResource Color.Muted}"
                 Text="{StaticResource Text.Register.Password}" />

      <TextBox Margin="0,4,0,0"
               Classes="field"
               PasswordChar="•"
               Text="{Binding Password, Mode=TwoWay}" />
    </StackPanel>

    <!-- Confirm Password -->
    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">

      <TextBlock HorizontalAlignment="Center"
                 FontFamily="{StaticResource FontDefault}"
                 FontSize="14"
                 Foreground="{StaticResource Color.Muted}"
                 Text="{StaticResource Text.Register.ConfirmPassword}" />

      <TextBox Margin="0,4,0,0"
               Classes="field"
               PasswordChar="•"
               Text="{Binding ConfirmPassword, Mode=TwoWay}" />
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">

      <Button Classes="flat primary"
              Command="{Binding ConfirmCommand}"
              Content="{StaticResource Text.Register}"
              FontFamily="{StaticResource FontDefault}"
              HotKey="Enter">
      </Button>

      <Button Classes="flat primary"
              Command="{Binding CancelCommand}"
              Content="{StaticResource Text.Cancel}"
              FontFamily="{StaticResource FontDefault}">
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>