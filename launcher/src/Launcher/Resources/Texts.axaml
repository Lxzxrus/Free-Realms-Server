<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Design.PreviewWith>
    <Border Padding="20">
      <TextBlock Text="{DynamicResource Text.Ok}" />
    </Border>
  </Design.PreviewWith>

  <!-- Common Actions -->
  <x:String x:Key="Text.Ok" xml:space="preserve">Ok</x:String>
  <x:String x:Key="Text.Yes" xml:space="preserve">Yes</x:String>
  <x:String x:Key="Text.No" xml:space="preserve">No</x:String>
  <x:String x:Key="Text.Cancel" xml:space="preserve">Cancel</x:String>
  <x:String x:Key="Text.Add" xml:space="preserve">Add</x:String>

  <!-- Main Window -->
  <x:String x:Key="Text.Servers" xml:space="preserve">Server List</x:String>
  <!-- Replaced at start-up by LauncherTitle from Directory.Build.props. -->
  <x:String x:Key="Text.Title" xml:space="preserve">Launcher</x:String>
  <x:String x:Key="Text.Main.Relaunching" xml:space="preserve">Relaunching...</x:String>
  <x:String x:Key="Text.Main.NoUpdatesFound" xml:space="preserve">No Updates Found! Launcher is up-to-date.</x:String>
  <x:String x:Key="Text.Main.Downloading" xml:space="preserve">>Downloading Update {0}... ({1}%)</x:String>
  <x:String x:Key="Text.Main.CheckingForUpdates" xml:space="preserve">Checking For Updates...</x:String>
  <x:String x:Key="Text.Main.UpdateError" xml:space="preserve">Error checking for updates.</x:String>
  <x:String x:Key="Text.Main.CheckingForUpdatesToolTip" xml:space="preserve">Check For Updates</x:String>
  <x:String x:Key="Text.Main.Error" xml:space="preserve">Oops :( We hit a roadblock...</x:String>
  <x:String x:Key="Text.Main.Info" xml:space="preserve">Good news!</x:String>
  <x:String x:Key="Text.Main.AddServer" xml:space="preserve">Add Server</x:String>

  <!-- Server Window -->
  <x:String x:Key="Text.Server.ClientFolder.Tooltip" xml:space="preserve">Open Client Directory</x:String>
  <x:String x:Key="Text.Server.ChooseClientFolder.Tooltip" xml:space="preserve">Use a Free Realms game folder you already have</x:String>
  <x:String x:Key="Text.Server.ChooseClientFolder.Title" xml:space="preserve">Choose your Free Realms game folder (the one with FreeRealms.exe)</x:String>
  <x:String x:Key="Text.Server.ChooseClientFolder.NoGame" xml:space="preserve">That folder has no {0}. Choose the folder the game itself is in.</x:String>
  <x:String x:Key="Text.Server.ChooseClientFolder.Chosen" xml:space="preserve">The game in this folder will be used:
{0}
When you press Play it's checked against the official Free Realms client first: changed or missing files are downloaded again, and program files that aren't part of the official game are moved out of the folder.</x:String>
  <x:String x:Key="Text.Server.DeleteServer.Tooltip" xml:space="preserve">Delete Server</x:String>

  <!-- Login -->
  <x:String x:Key="Text.Login" xml:space="preserve">Login</x:String>
  <x:String x:Key="Text.Login.Username" xml:space="preserve">Username:</x:String>
  <x:String x:Key="Text.Login.Password" xml:space="preserve">Password:</x:String>
  <x:String x:Key="Text.Login.Unauthorized" xml:space="preserve">Wrong username or password.</x:String>
  <x:String x:Key="Text.Login.Banned" xml:space="preserve">This account is banned.</x:String>
  <x:String x:Key="Text.Login.TooManyAttempts" xml:space="preserve">Too many login attempts. Try again in {0}.</x:String>
  <x:String x:Key="Text.Login.RememberUsername" xml:space="preserve">Remember Username</x:String>
  <x:String x:Key="Text.Login.Loading" xml:space="preserve">Logging In...</x:String>

  <!-- Register -->
  <x:String x:Key="Text.Register" xml:space="preserve">Register</x:String>
  <x:String x:Key="Text.Register.Username" xml:space="preserve">Username:</x:String>
  <x:String x:Key="Text.Register.Password" xml:space="preserve">Password:</x:String>
  <x:String x:Key="Text.Register.ConfirmPassword" xml:space="preserve">Confirm Password:</x:String>
  <x:String x:Key="Text.Register.ConfirmPassword.Error" xml:space="preserve">Passwords do not match.</x:String>
  <x:String x:Key="Text.Register.Success" xml:space="preserve">Registration complete! You can now log in.</x:String>
  <x:String x:Key="Text.Register.Conflict" xml:space="preserve">That name is taken. Please choose a different one.</x:String>
  <x:String x:Key="Text.Register.TooManyAttempts" xml:space="preserve">Too many accounts were created from your connection. Try again in {0}.</x:String>

  <!-- Answers from the server's web API -->
  <x:String x:Key="Text.WebApi.Invalid" xml:space="preserve">The server didn't accept that:
{0}</x:String>
  <x:String x:Key="Text.WebApi.InvalidUnknown" xml:space="preserve">The server didn't accept that username or password.</x:String>
  <x:String x:Key="Text.WebApi.ServerDown" xml:space="preserve">Can't reach the server. It may be down; please try again later.</x:String>
  <x:String x:Key="Text.WebApi.Insecure" xml:space="preserve">This server doesn't use HTTPS, so the launcher won't send your password or download files from it.</x:String>
  <x:String x:Key="Text.WebApi.Unexpected" xml:space="preserve">The server gave an unexpected answer ({0}). Please try again later.</x:String>
  <x:String x:Key="Text.Register.Loading" xml:space="preserve">Registering your account...</x:String>

  <!-- Server Operations -->
  <x:String x:Key="Text.Server.LocalHttpWarning" xml:space="preserve">Local test server without HTTPS. Don't reuse a real password here.</x:String>
  <x:String x:Key="Text.Server.GameServerOffline" xml:space="preserve">The game server is offline. Please try again later.</x:String>
  <x:String x:Key="Text.Server.ClientMissing" xml:space="preserve">The game isn't installed for this server. Put the Free Realms client (the folder with FreeRealms.exe) in:
{0}</x:String>
  <x:String x:Key="Text.Server.ClientPinMismatch" xml:space="preserve">FreeRealms.exe isn't the Free Realms game this launcher was made for, so it won't be started. It may have been changed or replaced. Put the original FreeRealms.exe back in:
{0}</x:String>
  <x:String x:Key="Text.Server.ClientPinUnreadable" xml:space="preserve">Couldn't read FreeRealms.exe to check it, so the game wasn't started. Close anything using it and try again.</x:String>
  <x:String x:Key="Text.Server.ClientPinNotConfigured" xml:space="preserve">This copy of the launcher was built without the game's fingerprint, so it can't check FreeRealms.exe and won't start the game. Download the launcher again from the official release page.</x:String>
  <x:String x:Key="Text.Server.ClientPinDownloadRefused" xml:space="preserve">The server sent a FreeRealms.exe that isn't the Free Realms game this launcher was made for. It wasn't saved, and the game won't be started.</x:String>
  <x:String x:Key="Text.Server.UnsafeClientManifest" xml:space="preserve">The server's list of game files is invalid, so nothing was downloaded.</x:String>
  <x:String x:Key="Text.Server.PreparingGameFiles" xml:space="preserve">Preparing Game Files: ({0}/{1})</x:String>
  <x:String x:Key="Text.Server.VerifyClientFiles" xml:space="preserve">Verifying Client Files...</x:String>
  <x:String x:Key="Text.Server.CheckingGameFiles" xml:space="preserve">Checking game files... {0}/{1}</x:String>
  <x:String x:Key="Text.Server.RepairingGameFiles" xml:space="preserve">Downloading official game files... {0}/{1}</x:String>
  <x:String x:Key="Text.Server.RepairFailed" xml:space="preserve">{0} game file(s) couldn't be downloaded from the official Free Realms client, so the game wasn't started. Check your internet connection and try again:
{1}</x:String>
  <x:String x:Key="Text.Server.UnofficialCodeMoved" xml:space="preserve">{0} file(s) in your game folder that the game could run weren't part of the official Free Realms client, so they were moved out of the way to:
{1}</x:String>
  <x:String x:Key="Text.Server.UnofficialCodeStuck" xml:space="preserve">These files in your game folder aren't part of the official Free Realms client, and couldn't be moved out of the way. The game wasn't started. Close anything using them, or delete them, and try again:
{0}</x:String>
  <x:String x:Key="Text.Server.CheckFailed" xml:space="preserve">The game files couldn't be checked, so the game wasn't started. Try again; if it keeps happening, look in the launcher's log.</x:String>
  <x:String x:Key="Text.Server.CodeCheckFailed" xml:space="preserve">Some of the game's program files changed since they were last checked, so the game wasn't started. Press Play again to check and repair them.</x:String>
  <x:String x:Key="Text.Server.ServerCodeRefused" xml:space="preserve">The server offered program files for your game folder. Servers may only add game data, so those files weren't downloaded.</x:String>
  <x:String x:Key="Text.ServerStatus" xml:space="preserve">Server Status: </x:String>
  <x:String x:Key="Text.ServerStatus.Online" xml:space="preserve">Online</x:String>
  <x:String x:Key="Text.ServerStatus.Locked" xml:space="preserve">Locked</x:String>
  <x:String x:Key="Text.ServerStatus.Offline" xml:space="preserve">Offline</x:String>
  <x:String x:Key="Text.ServerStatus.UnsupportedVersion" xml:space="preserve">Unsupported</x:String>
  <x:String x:Key="Text.ServerStatus.Refreshing" xml:space="preserve">Refreshing</x:String>
  <x:String x:Key="Text.OnlinePlayers" xml:space="preserve">Player Count: </x:String>

  <!-- Add Server -->
  <x:String x:Key="Text.Add_Server.ServerUrl" xml:space="preserve">Server URL:</x:String>
  <x:String x:Key="Text.Add_Server.Loading" xml:space="preserve">Adding Server...</x:String>
  <x:String x:Key="Text.Add_Server.InvalidServerUrl1" xml:space="preserve">Invalid url format. {0}</x:String>
  <x:String x:Key="Text.Add_Server.InvalidServerUrl2" xml:space="preserve">Invalid url, only HTTP/HTTPS is supported. {0}</x:String>
  <x:String x:Key="Text.Add_Server.HttpsRequired" xml:space="preserve">The address must start with https:// (plain http:// only works on your own network).</x:String>

  <!-- Delete Server -->
  <x:String x:Key="Text.Delete_Server" xml:space="preserve">Delete Server</x:String>
  <x:String x:Key="Text.Delete_Server.Loading" xml:space="preserve">Deleting Server...</x:String>
  <x:String x:Key="Text.Delete_Server.Confirm" xml:space="preserve">Are you sure you want to delete the server? This cannot be undone.</x:String>

  <!-- Downloading / Closing -->
  <x:String x:Key="Text.Downloading.OnClose" xml:space="preserve">Cannot close the launcher while downloading.</x:String>

  <!-- Settings -->
  <x:String x:Key="Text.Settings" xml:space="preserve">Settings</x:String>
  <x:String x:Key="Text.Settings.General.Locale" xml:space="preserve">Game Language: </x:String>
  <x:String x:Key="Text.Settings.General.Locale.Tooltip" xml:space="preserve">Select your language choice for the game.</x:String>
  <x:String x:Key="Text.Settings.General.ParallelDownload" xml:space="preserve">Parallel Download</x:String>
  <x:String x:Key="Text.Settings.General.ParallelDownloads" xml:space="preserve">Parallel Downloads: </x:String>
  <x:String x:Key="Text.Settings.General.ParallelDownload.Tooltip" xml:space="preserve">Enables / Disables parallel downloading. Hover over "parallel downloads" for more information. If parallel downloading isn't working as intended, consider disabling this option.</x:String>
  <x:String x:Key="Text.Settings.General.ParallelDownloads.Tooltip" xml:space="preserve">Number of parallel downloads. Higher values are faster on faster connections/SSDs but are more resource-intensive. Maximum recommended is your CPU core count; the default is half that.</x:String>

  <!-- Logs -->
  <x:String x:Key="Text.Logs" xml:space="preserve">Open Logs</x:String>

</ResourceDictionary>